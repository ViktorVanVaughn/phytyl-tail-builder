# tleap script of the minimal example. $PARAMS is the cofactor parameter folder (CLA, CHL, LUT, NEX ...
# .lib and .frcmod side by side), with the corrected chlorophyll b template (C8, C13 R) and the C2=C3 torsion
# X -c8-c5-X at phase 180. Load order: protein, lipids, water, GAFF2, ions, cofactor libraries, cofactor
# parameters; CHL.lib must come after leaprc.lipid21, where CHL is cholesterol.

source leaprc.protein.ff14SB
source leaprc.lipid21
source leaprc.water.tip3p
source leaprc.gaff2
loadamberparams frcmod.ionsjc_tip3p

loadoff $PARAMS/CLA.lib
loadoff $PARAMS/CHL.lib
loadoff $PARAMS/LUT.lib
loadoff $PARAMS/NEX.lib
loadoff $PARAMS/XAT.lib
loadoff $PARAMS/BCR.lib

loadamberparams $PARAMS/CLX.frcmod
loadamberparams $PARAMS/LUT.frcmod
loadamberparams $PARAMS/NEX.frcmod
loadamberparams $PARAMS/XAT.frcmod
loadamberparams $PARAMS/BCR.frcmod

addPdbAtomMap {
  {"HMA1"  "1HMA"}
  {"HMA2"  "2HMA"}
  {"HMA3"  "3HMA"}
  {"HAA1"  "1HAA"}
  {"HAA2"  "2HAA"}
  {"HBA1"  "1HBA"}
  {"HBA2"  "2HBA"}
  {"HMB1"  "1HMB"}
  {"HMB2"  "2HMB"}
  {"HMB3"  "3HMB"}
  {"HBB1"  "1HBB"}
  {"HBB2"  "2HBB"}
  {"HMC1"  "1HMC"}
  {"HMC2"  "2HMC"}
  {"HMC3"  "3HMC"}
  {"HAC1"  "1HAC"}
  {"HAC2"  "2HAC"}
  {"HBC1"  "1HBC"}
  {"HBC2"  "2HBC"}
  {"HBC3"  "3HBC"}
  {"HMD1"  "1HMD"}
  {"HMD2"  "2HMD"}
  {"HMD3"  "3HMD"}
  {"HED1"  "1HED"}
  {"HED2"  "2HED"}
  {"HED3"  "3HED"}
  {"H101"  "1H10"}
  {"H102"  "2H10"}
  {"H111"  "1H11"}
  {"H112"  "2H11"}
  {"H121"  "1H12"}
  {"H122"  "2H12"}
