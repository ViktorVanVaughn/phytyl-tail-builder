source leaprc.lipid21
source leaprc.water.tip3p
source leaprc.gaff2
source leaprc.protein.ff14SB


# Load libraries (charges/topology) for cofactors
loadoff $PARAMS/data/CLX/CLA.lib
loadoff $PARAMS/data/NEX/NEX.lib
loadoff $PARAMS/data/LUT/LUT.lib
loadoff $PARAMS/data/XAT/XAT.lib
loadoff $PARAMS/data/CLX/CHL.lib
loadoff $PARAMS/data/BCR/BCR.lib
loadoff $PARAMS/data/LHG/LHG.lib


# Load parameters for ions and cofactors
loadamberparams frcmod.ionsjc_tip3p
loadamberparams $PARAMS/data/CLX/CLX.frcmod
loadamberparams $PARAMS/data/NEX/NEX.frcmod
loadamberparams $PARAMS/data/LUT/LUT.frcmod
loadamberparams $PARAMS/data/XAT/XAT.frcmod
loadamberparams $PARAMS/data/BCR/BCR.frcmod
loadamberparams $PARAMS/data/LHG/LHG.frcmod

addPdbAtomMap {
