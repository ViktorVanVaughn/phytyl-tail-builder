  {"H203"  "3H20"}
  {"H11"    "1H1"}
  {"H12"    "2H1"}
  {"H41"    "1H4"}
  {"H42"    "2H4"}
  {"H43"    "3H4"}
  {"H51"    "1H5"}
  {"H52"    "2H5"}
  {"H61"    "1H6"}
