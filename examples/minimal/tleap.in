# Load the prepared pdb file 
LCC = loadpdb LCC_input.pdb

# Add box and ions
#addIons LCC Na+ 48

check LCC
#charge LCC

# Change radii for the GBn model
#set default PBradii bondi

# Save files for visualization 
#savemol2 LCC LCC.mol2 1
savepdb LCC LCC_no_sc.pdb

# Save parameters and coordinates
#saveamberparm LCC LCC.prmtop LCC.inpcrd

quit

